{
  "version": 1,
  "appId": "warehouse-manager",
  "workflows": [
    {
      "id":"shipment-intake","title":"Shipment and Tender Intake","description":"Capture shipments, tenders, lanes, SKUs, windows, documents, and service requirements from a declared source.",
      "fields":[{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"lane","label":"Origin to Destination","type":"text","required":true},{"key":"serviceLevel","label":"Service Level","type":"select","required":true,"options":["Standard","Expedited","Temperature controlled","White glove"]},{"key":"pickupDate","label":"Pickup Date","type":"date","required":true},{"key":"intakeSource","label":"Intake Source","type":"select","required":true,"options":["Manual","Local CSV","Configured TMS"]}],
      "states":["draft","validating","needs-information","accepted","tender-ready"],"transitions":[{"id":"validate","label":"Validate Shipment","from":["draft","needs-information"],"to":"validating"},{"id":"request-info","label":"Request Information","from":["validating"],"to":"needs-information"},{"id":"accept","label":"Accept Shipment","from":["validating"],"to":"accepted"},{"id":"tender","label":"Mark Tender Ready","from":["accepted"],"to":"tender-ready"}],
      "seeds":[{"id":"shipment-1001","state":"draft","shipmentRef":"SHP-2026-7011","lane":"Newark, NJ to Columbus, OH","serviceLevel":"Standard","pickupDate":"2026-07-16","intakeSource":"Manual"}]
    },
    {
      "id":"customs-document-check","title":"Customs Document Check","description":"Validate commercial invoices, packing lists, HS codes, origin, and required declarations before release.",
      "fields":[{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"documentSet","label":"Document Set","type":"textarea","required":true},{"key":"destinationCountry","label":"Destination Country","type":"text","required":true},{"key":"checkMode","label":"Check Mode","type":"select","required":true,"options":["Local rules","Manual broker review","Configured customs provider"]},{"key":"reviewer","label":"Compliance Reviewer","type":"text","required":true}],
      "states":["received","checking","findings-ready","correction-needed","cleared"],"transitions":[{"id":"check","label":"Run Document Checks","from":["received","correction-needed"],"to":"checking"},{"id":"findings","label":"Save Findings","from":["checking"],"to":"findings-ready"},{"id":"correct","label":"Request Correction","from":["findings-ready"],"to":"correction-needed"},{"id":"clear","label":"Clear Documents","from":["findings-ready"],"to":"cleared"}],
      "seeds":[{"id":"customs-check-1001","state":"received","shipmentRef":"SHP-2026-7012","documentSet":"Commercial invoice and packing list","destinationCountry":"Canada","checkMode":"Local rules","reviewer":"Reese Coleman"}]
    },
    {
      "id":"sanctions-screening","title":"Trade Sanctions Screening","description":"Screen shippers, consignees, carriers, routes, countries, and counterparties using explicit test or configured sources.",
      "fields":[{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"screeningScope","label":"Screening Scope","type":"select","required":true,"options":["Shipper","Consignee","Carrier","Route","All parties"]},{"key":"provider","label":"Screening Provider","type":"select","required":true,"options":["Local test list","Manual review","Configured provider"]},{"key":"matchThreshold","label":"Match Threshold","type":"number","required":true},{"key":"analyst","label":"Screening Analyst","type":"text","required":true}],
      "states":["queued","screening","potential-match","cleared","escalated"],"transitions":[{"id":"screen","label":"Run Screening","from":["queued"],"to":"screening"},{"id":"match","label":"Record Potential Match","from":["screening"],"to":"potential-match"},{"id":"clear","label":"Clear Screening","from":["screening","potential-match"],"to":"cleared"},{"id":"escalate","label":"Escalate Match","from":["potential-match"],"to":"escalated"}],
      "seeds":[{"id":"sanctions-screen-1001","state":"queued","shipmentRef":"SHP-2026-7012","screeningScope":"All parties","provider":"Local test list","matchThreshold":85,"analyst":"Kai Bennett"}]
    },
    {
      "id":"quote-optimization","title":"Freight Quote Optimization","description":"Recommend a quote using lane history, capacity, local spot inputs, margin target, and service commitment.",
      "fields":[{"key":"quoteRef","label":"Quote Reference","type":"text","required":true},{"key":"lane","label":"Lane","type":"text","required":true},{"key":"costBasis","label":"Estimated Cost","type":"number","required":true},{"key":"targetMarginPct","label":"Target Margin Percent","type":"number","required":true},{"key":"marketSource","label":"Market Source","type":"select","required":true,"options":["Local history","Manual spot input","Configured rate provider"]}],
      "states":["draft","optimizing","review","approved","rejected","offered"],"transitions":[{"id":"optimize","label":"Optimize Quote","from":["draft"],"to":"optimizing"},{"id":"review","label":"Start Pricing Review","from":["optimizing"],"to":"review"},{"id":"approve","label":"Approve Quote","from":["review"],"to":"approved"},{"id":"reject","label":"Reject Quote","from":["review"],"to":"rejected"},{"id":"offer","label":"Record Customer Offer","from":["approved"],"to":"offered"}],
      "seeds":[{"id":"quote-run-1001","state":"draft","quoteRef":"QT-2026-3301","lane":"Newark, NJ to Columbus, OH","costBasis":1480,"targetMarginPct":18,"marketSource":"Local history"}]
    },
    {
      "id":"exception-alerts","title":"Shipment Exception Management","description":"Flag delays, missing documents, capacity changes, customs holds, temperature excursions, and claims risk for action.",
      "fields":[{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"exceptionType","label":"Exception Type","type":"select","required":true,"options":["Delay","Missing document","Capacity change","Customs hold","Temperature excursion","Claims risk"]},{"key":"severity","label":"Severity","type":"select","required":true,"options":["Low","Medium","High","Critical"]},{"key":"owner","label":"Exception Owner","type":"text","required":true},{"key":"responseDue","label":"Response Due","type":"date","required":true}],
      "states":["open","acknowledged","investigating","mitigated","resolved","escalated"],"transitions":[{"id":"acknowledge","label":"Acknowledge Alert","from":["open"],"to":"acknowledged"},{"id":"investigate","label":"Start Investigation","from":["acknowledged"],"to":"investigating"},{"id":"mitigate","label":"Record Mitigation","from":["investigating"],"to":"mitigated"},{"id":"resolve","label":"Resolve Exception","from":["mitigated"],"to":"resolved"},{"id":"escalate","label":"Escalate Exception","from":["acknowledged","investigating"],"to":"escalated"}],
      "seeds":[{"id":"exception-1001","state":"open","shipmentRef":"SHP-2026-7011","exceptionType":"Delay","severity":"Medium","owner":"Dispatch Team East","responseDue":"2026-07-14"}]
    },
    {
      "id":"cold-chain-compliance","title":"Cold Chain Compliance","description":"Track temperature readings, excursion windows, corrective actions, evidence, and release approval.",
      "fields":[{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"minTemperature","label":"Minimum Temperature","type":"number","required":true},{"key":"maxTemperature","label":"Maximum Temperature","type":"number","required":true},{"key":"readingSource","label":"Reading Source","type":"select","required":true,"options":["Local fixture","Manual logger","Configured sensor provider"]},{"key":"complianceOwner","label":"Compliance Owner","type":"text","required":true}],
      "states":["monitoring","excursion-detected","corrective-action","quality-review","released","quarantined"],"transitions":[{"id":"excursion","label":"Record Excursion","from":["monitoring"],"to":"excursion-detected"},{"id":"correct","label":"Start Corrective Action","from":["excursion-detected"],"to":"corrective-action"},{"id":"review","label":"Request Quality Review","from":["corrective-action"],"to":"quality-review"},{"id":"release","label":"Release Shipment","from":["monitoring","quality-review"],"to":"released"},{"id":"quarantine","label":"Quarantine Shipment","from":["excursion-detected","quality-review"],"to":"quarantined"}],
      "seeds":[{"id":"cold-chain-1001","state":"monitoring","shipmentRef":"SHP-2026-7020","minTemperature":2,"maxTemperature":8,"readingSource":"Local fixture","complianceOwner":"Cold Chain Quality"}]
    },
    {
      "id":"carrier-performance","title":"Carrier Performance Scorecard","description":"Measure on-time pickup and delivery, claims, communication, rate reliability, and compliance for a defined period.",
      "fields":[{"key":"carrierRef","label":"Carrier Reference","type":"text","required":true},{"key":"period","label":"Measurement Period","type":"text","required":true},{"key":"laneScope","label":"Lane Scope","type":"text","required":true},{"key":"minimumLoads","label":"Minimum Load Count","type":"number","required":true},{"key":"reviewOwner","label":"Review Owner","type":"text","required":true}],
      "states":["configured","calculating","review","published","disputed"],"transitions":[{"id":"calculate","label":"Calculate Metrics","from":["configured"],"to":"calculating"},{"id":"review","label":"Review Scorecard","from":["calculating"],"to":"review"},{"id":"publish","label":"Publish Scorecard","from":["review"],"to":"published"},{"id":"dispute","label":"Record Dispute","from":["review","published"],"to":"disputed"},{"id":"recalculate","label":"Recalculate","from":["disputed"],"to":"calculating"}],
      "seeds":[{"id":"carrier-score-1001","state":"configured","carrierRef":"CAR-1042","period":"2026 Q2","laneScope":"US Northeast and Midwest","minimumLoads":10,"reviewOwner":"Carrier Management"}]
    },
    {
      "id":"landed-cost","title":"Landed Cost Calculation","description":"Calculate freight, duties, taxes, accessorials, detention, insurance, and margin with reviewable components.",
      "fields":[{"key":"calculationRef","label":"Calculation Reference","type":"text","required":true},{"key":"shipmentRef","label":"Shipment Reference","type":"text","required":true},{"key":"goodsValue","label":"Goods Value","type":"number","required":true},{"key":"currency","label":"Currency","type":"select","required":true,"options":["USD","CAD","EUR","GBP"]},{"key":"dutySource","label":"Duty Source","type":"select","required":true,"options":["Local tariff table","Manual input","Configured customs provider"]}],
      "states":["draft","calculating","review","approved","revised"],"transitions":[{"id":"calculate","label":"Calculate Cost","from":["draft","revised"],"to":"calculating"},{"id":"review","label":"Review Components","from":["calculating"],"to":"review"},{"id":"approve","label":"Approve Calculation","from":["review"],"to":"approved"},{"id":"revise","label":"Revise Inputs","from":["review"],"to":"revised"}],
      "seeds":[{"id":"landed-cost-1001","state":"draft","calculationRef":"LC-2026-451","shipmentRef":"SHP-2026-7012","goodsValue":42000,"currency":"USD","dutySource":"Local tariff table"}]
    }
  ],
  "resources":[
    {"name":"shipment_intake_batches","type":"table","workflowId":"shipment-intake"},{"name":"shipment_intake_items","type":"table","workflowId":"shipment-intake"},
    {"name":"customs_document_checks","type":"table","workflowId":"customs-document-check"},{"name":"customs_findings","type":"table","workflowId":"customs-document-check"},
    {"name":"sanctions_screenings","type":"table","workflowId":"sanctions-screening"},{"name":"sanctions_matches","type":"table","workflowId":"sanctions-screening"},
    {"name":"quote_optimization_runs","type":"table","workflowId":"quote-optimization"},{"name":"quote_recommendations","type":"table","workflowId":"quote-optimization"},
    {"name":"shipment_exceptions","type":"table","workflowId":"exception-alerts"},{"name":"exception_events","type":"table","workflowId":"exception-alerts"},
    {"name":"cold_chain_readings","type":"table","workflowId":"cold-chain-compliance"},{"name":"temperature_excursions","type":"table","workflowId":"cold-chain-compliance"},{"name":"cold_chain_evidence","type":"table","workflowId":"cold-chain-compliance"},
    {"name":"carrier_performance_metrics","type":"view","workflowId":"carrier-performance"},{"name":"lane_carrier_scorecards","type":"view","workflowId":"carrier-performance"},
    {"name":"landed_cost_calculations","type":"table","workflowId":"landed-cost"},{"name":"landed_cost_components","type":"table","workflowId":"landed-cost"}
